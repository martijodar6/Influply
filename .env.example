# ---- Database ----
# Postgres connection string, used in both development and production
# (e.g. from a free Neon or Supabase project). Run `npm run db:push`
# after setting this to create the tables.
DATABASE_URL="postgresql://user:password@host:5432/influply"

# ---- NextAuth ----
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Transactional email (password reset) ----
# Leave empty during local development: reset links are printed to the
# server console instead of being emailed. Fill these in with a real
# SMTP provider (Resend, Postmark, SendGrid SMTP, Gmail app password...)
# before deploying to production so password recovery actually sends mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Influply <no-reply@influply.com>"

# ---- Media storage ----
# "local" writes uploads to /public/uploads on disk — fine for local dev
# and for a traditional always-on server, but Vercel's serverless
# filesystem is read-only/ephemeral in production, so deploying there
# requires wiring lib/storage.ts's "s3" driver to a real bucket
# (S3, R2, Vercel Blob...) first. See README.md "Media storage" section.
STORAGE_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""
